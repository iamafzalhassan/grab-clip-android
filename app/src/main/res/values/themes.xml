<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GrabClip" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_base</item>
    </style>

    <style name="Theme.GrabClip.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.GrabClip</item>
    </style>
</resources>
